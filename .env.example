# Copy to .env.local (git-ignored) and fill in. Never commit a real key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default: gemini-flash-lite-latest, falling back to gemini-flash-latest)
# GEMINI_MODEL=

# Optional fallback if Gemini is missing or fails. Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the Groq model (default: llama-3.3-70b-versatile)
GROQ_MODEL=
